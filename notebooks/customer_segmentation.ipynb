#importing libraries
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

# READ DATA FROM CSV FILE
df_retail = pd.read_csv("RetailCleaned.CSV", header = None, low_memory = False)

# ADD COLUMN TO DataFrame
df_retail.columns = ['Invoice', 'StockCode', 'Description', 'Quantity', 'InvoiceDate', 'Price', 'Customer_ID', 'Country', 'SourceSheet']

# DATA CLEANSING - CHANGE INVOICE DATE TO DATETYPE
df_retail['InvoiceDate'] = pd.to_datetime(df_retail['InvoiceDate'])
df_retail.info()

rfm_data = df_retail[ (df_retail['Customer_ID'].notna()) & (df_retail['Quantity'] > 0) ].copy()

snapshot_date = df_retail['InvoiceDate'].max()
snapshot_date = snapshot_date + pd.Timedelta(days = 1)

rfm_score = rfm_data.groupby('Customer_ID').agg(
    Recency = ('InvoiceDate', lambda x: (snapshot_date - x.max()).days ),
    Frequency = ('Invoice', 'nunique'),
    Monetary = ('Quantity', lambda x: (x * rfm_data.loc[x.index, 'Price']).sum())
).reset_index()

rfm_score['R_Score'] = pd.qcut(rfm_score['Recency'], 5, labels = [5, 4, 3, 2, 1]).astype(int)
rfm_score['F_Score'] = pd.qcut(rfm_score['Frequency'].rank(method = 'first'), 5, labels = [1, 2, 3, 4, 5]).astype(int)
rfm_score['M_Score'] = pd.qcut(rfm_score['Monetary'], 5, labels = [1, 2, 3, 4 , 5]).astype(int)

def segment_customer(row):
    if row['R_Score'] >= 4 and row['F_Score'] >= 4 and row['M_Score'] >= 4:
        return 'Champion'
    elif row['R_Score'] >= 3 and row['F_Score'] >= 3:
        return 'Loyal'
    elif row['R_Score'] <= 2 and row['F_Score'] >= 3:
        return 'At Risk'
    elif row['R_Score'] >= 4 and row['F_Score'] <= 2:
        return 'New'
    elif row['R_Score'] == 3 and row['F_Score'] <= 2:
        return 'Need Attention'
    else:
        return 'Lost'

rfm_score['Customer_Value'] = rfm_score.apply(segment_customer, axis = 1)
rfm_score['isChurned'] = rfm_score['Recency'] > 90

# MERGE RFM REPORT BACK ONTO TRANSACTION AND EXPORT
df_retail = df_retail[ (df_retail['Customer_ID'].notna()) & (df_retail['Quantity'] > 0) ].copy()
df_retail['InvoiceMonth'] = df_retail['InvoiceDate'].dt.to_period('M').dt.to_timestamp()
df_retail['Revenue'] = df_retail['Quantity'] * df_retail['Price']

df_final = df_retail.merge(rfm_score, on = 'Customer_ID', how = 'left')

df_final.to_excel('EcommerceDashboardData.xlsx', index = False)
